# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Database (Supabase Postgres connection string)
# Use a dedicated schema (hrms) so Prisma doesn't touch Supabase-managed public/auth tables
# Example format from Supabase:
# postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres?schema=hrms&sslmode=require
DATABASE_URL=postgresql://postgres:<YOUR_SUPABASE_PASSWORD>@<YOUR_SUPABASE_HOST>:5432/postgres?schema=hrms&sslmode=require
